TZ={{ immich_kiosk_environment_variables_tz }}

{#
  See: https://docs.immichkiosk.app/configuration/
#}

LANG={{ immich_kiosk_environment_variables_lang }}

KIOSK_BEHIND_PROXY={{ immich_kiosk_environment_variables_kiosk_behind_proxy }}

KIOSK_DISABLE_URL_QUERIES={{ immich_kiosk_environment_variables_kiosk_disable_url_queries }}

KIOSK_IMMICH_API_KEY={{ immich_kiosk_environment_variables_kiosk_immich_api_key }}
KIOSK_IMMICH_URL={{ immich_kiosk_environment_variables_kiosk_immich_url }}
KIOSK_IMMICH_EXTERNAL_URL={{ immich_kiosk_environment_variables_kiosk_immich_external_url }}


{{ immich_kiosk_environment_variables_additional_variables }}
{# Keep legacy settings for older image overrides and supply their current aliases.
   Explicit current settings take precedence; duplicate legacy settings use the last value. #}
{% set additional_lines = immich_kiosk_environment_variables_additional_variables.splitlines() %}
{% for old, new in [
  ('KIOSK_SHOW_MORE_INFO', 'KIOSK_MORE_INFO_DISPLAY'),
  ('KIOSK_SHOW_MORE_INFO_IMAGE_LINK', 'KIOSK_MORE_INFO_SHOW_ASSET_LINK'),
  ('KIOSK_SHOW_MORE_INFO_QR_CODE', 'KIOSK_MORE_INFO_SHOW_QR_CODE'),
  ('KIOSK_LIKE_BUTTON_ACTION', 'KIOSK_MORE_INFO_LIKE_BUTTON_ACTION'),
  ('KIOSK_HIDE_BUTTON_ACTION', 'KIOSK_MORE_INFO_HIDE_BUTTON_ACTION'),
] %}
{% set legacy = additional_lines | select('match', '^\\s*' ~ old ~ '=') | list %}
{% if legacy and not (additional_lines | select('match', '^\\s*' ~ new ~ '=') | list) %}
{{ legacy | last | regex_replace('^\\s*' ~ old ~ '=', new ~ '=') }}
{% endif %}
{% endfor %}
